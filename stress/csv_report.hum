note: Round 2, test 4 again with HumanLang 0.3: read a sales CSV file, clean it, and report on it.
note: Input columns: date, region, product, units, price
use files
use text
use math

ask "CSV file:" and save it as path
if not (file exists path)
    say "No such file: {path}"
    stop the program
set table to read csv path as rows
say "Read {how many items in table} rows."
if how many items in table is 0
    say "The file is empty."
    stop the program

set header to empty list
for each h in item 1 of table
    add lowercase of (trim of h) to header
if header is not list of "date", "region", "product", "units", "price"
    say "Unexpected columns: {join header by ", "}"
    stop the program

note: ---------- checking each row ----------
set good to empty list
set problems to empty list
set n to 1
repeat while n is less than how many items in table
    add 1 to n
    set r to item n of table
    if r is list of ""
        skip
    if how many items in r is not 5
        add "row {n}: expected 5 columns, found {how many items in r}" to problems
        skip
    try
        set units to number of (trim of (item 4 of r))
        if units is less than 0 or units is not floor of units
            fail with "units"
    if that fails
        add "row {n}: units must be a whole number and nothing can be negative" to problems
        skip
    try
        set price to number of (trim of (item 5 of r))
        if price is less than 0
            fail with "price"
    if that fails
        add "row {n}: units or price is not a number" to problems
        skip
    add (record with date (trim of (item 1 of r)) and region (trim of (item 2 of r)) and product (trim of (item 3 of r)) and units units and price price) to good
say "{how many items in good} good rows, {how many items in problems} rejected."
for each p in problems
    say "  rejected {p}"

note: ---------- totals per region and per product ----------
set by_region to empty record
set by_product to empty record
set grand to 0
for each rec in good
    set amount to (field units of rec) * (field price of rec)
    set grand to grand + amount
    set reg to field region of rec
    if by_region has field (reg)
        change field (reg) of by_region to (field (reg) of by_region) + amount
    otherwise
        set field (reg) of by_region to amount
    set prod to field product of rec
    if by_product has field (prod)
        change field (prod) of by_product to (field (prod) of by_product) + (field units of rec)
    otherwise
        set field (prod) of by_product to field units of rec
say ""
say "Sales by region"
for each reg in sorted of (keys of by_region)
    say "  {reg}: {text of (field (reg) of by_region) to 2 places}"
say "Units by product"
for each prod in sorted of (keys of by_product)
    say "  {prod}: {field (prod) of by_product}"
say "Grand total: {text of grand to 2 places}"

note: ---------- writing a tidy copy ----------
set out_rows to list of (list of "date", "region", "product", "units", "price", "total")
for each rec in good
    set price to field price of rec
    add (list of (field date of rec), (field region of rec), (field product of rec), (field units of rec), (text of price to 2 places), (text of ((field units of rec) * price) to 2 places)) to out_rows
write csv out_rows to file path + ".clean"
say "Wrote {how many items in out_rows} lines to {path}.clean"
