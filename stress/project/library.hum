note: ===== module: util (small helpers used by every other module) =====
use text
use math

define pad_right with value and width
    set t to text of value
    repeat while (length of t) is less than width
        set t to t + " "
    give back t

define pad_left with value and width
    set t to text of value
    repeat while (length of t) is less than width
        set t to " " + t
    give back t

define cents_text with cents
    set whole to floor of (cents / 100)
    set rest to cents - whole * 100
    set rest_text to text of rest
    if rest is less than 10
        set rest_text to "0" + rest_text
    give back "{whole}.{rest_text}"

define all_digits with t
    if t is ""
        give back no
    for each ch in t
        if not ("0123456789" contains ch)
            give back no
    give back yes

note: ===== module: store (the books) =====
note: a book is a record: id, title, copies, out (how many are lent)
set books to empty list

define find_book with id
    set i to 1
    repeat while i is at most how many items in books
        if (field id of (item i of books)) is id
            give back i
        add 1 to i
    give back 0

define add_book with id and title and copies
    if (find_book with id) is not 0
        fail with "book {id} already exists"
    if copies is less than 1
        fail with "a book needs at least 1 copy"
    add (record with id id and title title and copies copies and out 0) to books

define lend_book with id
    set at to find_book with id
    if at is 0
        fail with "no book {id}"
    set book to item at of books
    if (field out of book) is at least (field copies of book)
        fail with "all copies of {id} are out"
    change field out of item at of books to (field out of book) + 1

note: ===== module: members (people, and what each one has borrowed) =====
set members to empty list
set LIMIT to 2

define find_member with name
    set i to 1
    repeat while i is at most how many items in members
        if (field name of (item i of members)) is name
            give back i
        add 1 to i
    give back 0

define add_member with name
    if (find_member with name) is not 0
        fail with "member {name} already exists"
    add (record with name name and loans empty list) to members

define take_loan with name and id and day
    set at to find_member with name
    if at is 0
        fail with "no member {name}"
    set m to item at of members
    if (how many items in (field loans of m)) is at least LIMIT
        fail with "{name} already has {LIMIT} books"
    for each loan in field loans of m
        if (field id of loan) is id
            fail with "{name} already has {id}"
    lend_book with id
    add (record with id id and day day) to field loans of item at of members

define end_loan with name and id and day
    set at to find_member with name
    if at is 0
        fail with "no member {name}"
    set loans to field loans of (item at of members)
    set k to 1
    repeat while k is at most how many items in loans
        if (field id of (item k of loans)) is id
            set taken to field day of (item k of loans)
            remove (item k of loans) from field loans of item at of members
            note: the book comes back to the shelf
            set shelf_at to find_book with id
            set shelf_book to item shelf_at of books
            change field out of item shelf_at of books to (field out of shelf_book) - 1
            give back fee_for with (day - taken)
        add 1 to k
    fail with "{name} does not have {id}"

define fee_for with days_out
    if days_out is at most 14
        give back 0
    give back (days_out - 14) * 10

note: ===== module: report (tables) =====
define show_books
    say "{pad_right with "ID" and 6}{pad_right with "TITLE" and 22}{pad_left with "OUT" and 4}{pad_left with "OF" and 4}"
    for each b in sorted of books by field id
        say "{pad_right with (field id of b) and 6}{pad_right with (field title of b) and 22}{pad_left with (field out of b) and 4}{pad_left with (field copies of b) and 4}"

define show_members
    for each m in sorted of members by field name
        set ids to empty list
        for each loan in field loans of m
            add field id of loan to ids
        say "{pad_right with (field name of m) and 10}{join ids by ", "}"

note: ===== module: main (reads commands, one per line, until "quit") =====
set fees_total to 0
set errors to 0

define run_command with line
    set words to split line by " "
    set cmd to item 1 of words
    if cmd is "book"
        note: book ID COPIES TITLE...
        set copies to number of (item 3 of words)
        set title to join (rest_of with words and 4) by " "
        add_book with (item 2 of words) and title and copies
        say "ok: added {title}"
    otherwise if cmd is "join"
        add_member with (item 2 of words)
        say "ok: welcome {item 2 of words}"
    otherwise if cmd is "borrow"
        if not (all_digits with (item 4 of words))
            fail with "day must be a whole number"
        take_loan with (item 2 of words) and (item 3 of words) and (number of (item 4 of words))
        say "ok: {item 2 of words} borrowed {item 3 of words}"
    otherwise if cmd is "return"
        if not (all_digits with (item 4 of words))
            fail with "day must be a whole number"
        set fee to end_loan with (item 2 of words) and (item 3 of words) and (number of (item 4 of words))
        change fees_total to fees_total + fee
        say "ok: {item 2 of words} returned {item 3 of words}, fee {cents_text with fee}"
    otherwise if cmd is "books"
        show_books
    otherwise if cmd is "members"
        show_members
    otherwise
        fail with "unknown command {cmd}"

define rest_of with words and start
    set out to empty list
    set i to start
    repeat while i is at most how many items in words
        add item i of words to out
        add 1 to i
    give back out

repeat while yes
    ask "> " and save it as line
    if line is "quit"
        stop
    if trim of line is ""
        skip
    try
        run_command with line
    if that fails
        add 1 to errors
        say "error: {problem}"
say "Fees collected: {cents_text with fees_total}. Errors: {errors}."

