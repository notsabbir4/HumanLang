note: A contact book that remembers its contacts between runs, in the file contacts.txt.
note: File format: first line is "HL-CONTACTS 1", then one contact per line as name|phone|email
note: (Version 2: records, "file exists", appending, and "sorted ... by field".)
use files
use text

set file_name to "contacts.txt"
set header to "HL-CONTACTS 1"
set book to empty list
set damaged to empty list

note: ---------- reading and writing the file ----------
define load_book
    if not file exists file_name
        say "(No contact file yet - starting with an empty book.)"
        give back nothing
    set lines to split (read file file_name) by "\n"
    note: "contains", not "is": a Windows editor may put an invisible mark in front (read file skips it, but be safe)
    if not ((item 1 of lines) contains header)
        fail with "{file_name} doesn't look like a contact file, so I won't touch it. Rename or move it, then run me again."
    for each line in (rest_of with lines)
        set one to trim of line
        if one is not ""
            set parts to split one by "|"
            if how many items in parts is 3
                add (record with name item 1 of parts and phone item 2 of parts and email item 3 of parts) to book
            otherwise
                add one to damaged
    if how many items in damaged is greater than 0
        say "WARNING: {how many items in damaged} damaged line(s) in {file_name}. I will keep them as they are."

define rest_of with lines
    note: everything but the first line
    give back items 2 to (how many items in lines) of lines

define line_for with contact
    give back "{field name of contact}|{field phone of contact}|{field email of contact}"

define save_book
    set out to list of header
    for each contact in book
        add line_for with contact to out
    for each one in damaged
        add one to out
    write "{join out by "\n"}\n" to file file_name

define find_contact with wanted
    set at to 1
    repeat while at is at most how many items in book
        if lowercase of (field name of item at of book) is lowercase of wanted
            give back at
        add 1 to at
    give back 0

define show_one with contact
    say "  {field name of contact}  |  {field phone of contact}  |  {field email of contact}"

note: ---------- checking what the user typed ----------
define clean_field with label and value
    set value to trim of value
    if value contains "|"
        fail with "{label} can't contain the | character."
    give back value

define check_phone with value
    if length of value is less than 5
        fail with "That doesn't look like a phone number."
    for each ch in value
        if not ("0123456789+-() " contains ch)
            fail with "That doesn't look like a phone number."

define check_email with value
    if value is ""
        give back nothing
    set parts to split value by "@"
    if how many items in parts is not 2 or (item 1 of parts) is "" or not ((item 2 of parts) contains ".") or value contains " "
        fail with "That doesn't look like an email address."

note: ---------- actions (each one reports its own problems with "fail with") ----------
define add_contact
    ask "Name: " and save it as who
    set who to clean_field with "Name" and who
    if who is ""
        fail with "A name can't be empty."
    if (find_contact with who) is not 0
        fail with "{who} is already in your book. Use 'update' to change them."
    ask "Phone: " and save it as phone
    set phone to clean_field with "Phone" and phone
    check_phone with phone
    ask "Email (or leave empty): " and save it as email
    set email to clean_field with "Email" and email
    check_email with email
    set contact to record with name who and phone phone and email email
    add contact to book
    note: one line added to the end of the file, so nothing else in it is touched
    if file exists file_name
        add "{line_for with contact}\n" to file file_name
    otherwise
        write "{header}\n{line_for with contact}\n" to file file_name
    say "Saved {who}."

define list_all
    if how many items in book is 0
        say "Your book is empty."
        give back nothing
    for each contact in sorted of book by field name
        show_one with contact
    say "{how many items in book} contact(s)."

define search_contacts
    ask "Search for: " and save it as wanted
    set wanted to lowercase of trim of wanted
    set hits to 0
    for each contact in book
        if lowercase of (line_for with contact) contains wanted
            show_one with contact
            add 1 to hits
    if hits is 0
        say "No match."

define update_contact
    ask "Who do you want to change? " and save it as who
    set at to find_contact with who
    if at is 0
        fail with "I couldn't find \"{who}\"."
    say "Leave a line empty to keep the old value."
    ask "New phone [{field phone of item at of book}]: " and save it as phone
    set phone to clean_field with "Phone" and phone
    if phone is not ""
        check_phone with phone
    ask "New email [{field email of item at of book}]: " and save it as email
    set email to clean_field with "Email" and email
    check_email with email
    if phone is not ""
        change field phone of item at of book to phone
    if email is not ""
        change field email of item at of book to email
    save_book
    say "Updated {field name of item at of book}."

define delete_contact
    ask "Who do you want to delete? " and save it as who
    set at to find_contact with who
    if at is 0
        fail with "I couldn't find \"{who}\"."
    ask "Really delete {field name of item at of book}? (yes/no) " and save it as sure
    if lowercase of sure is not "yes"
        say "Kept."
        give back nothing
    remove item at of book from book
    save_book
    say "Deleted."

note: ---------- main ----------
load_book
say "Contact book: {how many items in book} contact(s) loaded."
repeat while yes
    ask "[add / list / search / update / delete / quit] " and save it as command
    set command to lowercase of trim of command
    try
        if command is "add"
            add_contact
        otherwise if command is "list"
            list_all
        otherwise if command is "search"
            search_contacts
        otherwise if command is "update"
            update_contact
        otherwise if command is "delete"
            delete_contact
        otherwise if command is "quit"
            say "Goodbye!"
            stop the program
        otherwise
            say "I don't know \"{command}\". Try add, list, search, update, delete or quit."
    if that fails
        say "{problem}"
