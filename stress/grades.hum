note: Student grade manager (version 2: each student is a record, so nothing has to stay "in step").
use math
use text

set students to empty list

note: ---------- helpers ----------
define find_student with wanted
    note: gives back the position of a student, or 0 when not found
    set at to 1
    repeat while at is at most how many items in students
        if lowercase of (field name of item at of students) is lowercase of wanted
            give back at
        add 1 to at
    give back 0

define average_of with scores
    if how many items in scores is 0
        give back 0
    give back round of (sum of scores / how many items in scores * 100) / 100

define letter_for with average
    if average is at least 90
        give back "A"
    if average is at least 80
        give back "B"
    if average is at least 70
        give back "C"
    if average is at least 60
        give back "D"
    give back "F"

define pad with word and width
    set padded to word
    repeat while length of padded is less than width
        add " " to padded
    give back padded

define ask_mark with question
    ask number question and save it as mark
    repeat while mark is less than 0 or mark is greater than 100
        say "A mark must be between 0 and 100."
        ask number question and save it as mark
    give back mark

note: ---------- actions ----------
define add_student
    ask "Student name: " and save it as new_name
    set new_name to trim of new_name
    if new_name is ""
        say "A name can't be empty."
        give back nothing
    if (find_student with new_name) is not 0
        say "{new_name} is already in the class."
        give back nothing
    add (record with name new_name and marks empty list) to students
    say "Added {new_name}."

define add_mark
    ask "Which student? " and save it as who
    set at to find_student with who
    if at is 0
        say "I don't know a student called \"{who}\"."
        give back nothing
    set mark to ask_mark with "Mark (0-100): "
    add mark to field marks of item at of students
    say "Recorded {mark} for {field name of item at of students}."

define remove_student
    ask "Remove which student? " and save it as who
    set at to find_student with who
    if at is 0
        say "I don't know a student called \"{who}\"."
        give back nothing
    remove item at of students from students
    say "Removed {who}."

define show_report
    if how many items in students is 0
        say "No students yet."
        give back nothing
    say (pad with "Name" and 14) plus (pad with "Marks" and 7) plus (pad with "Average" and 9) plus "Grade"
    set total_of_averages to 0
    set counted to 0
    for each student in students
        set mine to field marks of student
        if how many items in mine is 0
            say (pad with (field name of student) and 14) plus (pad with "0" and 7) plus (pad with "-" and 9) plus "-"
        otherwise
            set avg to average_of with mine
            say (pad with (field name of student) and 14) plus (pad with (text of how many items in mine) and 7) plus (pad with (text of avg) and 9) plus (letter_for with avg)
            add avg to total_of_averages
            add 1 to counted
    if counted is greater than 0
        say "Class average: {round of (total_of_averages / counted * 100) / 100}"

define show_ranking
    note: students with at least one mark, best average first
    set ranked to empty list
    for each student in students
        if how many items in (field marks of student) is greater than 0
            add (record with name field name of student and average average_of with (field marks of student)) to ranked
    if how many items in ranked is 0
        say "Nobody has marks yet."
        give back nothing
    set place to 1
    for each row in reversed of (sorted of ranked by field average)
        say "{place}. {field name of row} - {field average of row}"
        add 1 to place

define show_at_risk
    set found to no
    for each student in students
        if how many items in (field marks of student) is greater than 0
            set avg to average_of with (field marks of student)
            if avg is less than 60
                say "{field name of student} is failing ({avg})."
                set found to yes
    if not found
        say "Nobody is failing."

note: ---------- the menu ----------
repeat while yes
    say ""
    say "1 Add student   2 Add mark   3 Report   4 Ranking   5 At risk   6 Remove   0 Quit"
    ask number "Choose: " and save it as choice
    if choice is 1
        add_student
    otherwise if choice is 2
        add_mark
    otherwise if choice is 3
        show_report
    otherwise if choice is 4
        show_ranking
    otherwise if choice is 5
        show_at_risk
    otherwise if choice is 6
        remove_student
    otherwise if choice is 0
        say "Goodbye!"
        stop the program
    otherwise
        say "Please choose a number from the menu."
