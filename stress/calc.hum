note: A calculator that understands + - * / % ^ brackets, decimals and negative numbers,
note: with the usual rules: brackets first, then ^, then * / %, then + -.
note: (Version 2: "fail with" replaces the error flag, "is a number" replaces the kinds list.)

set tokens to empty list
set position to 1

note: ---------- step 1: cut the text into tokens ----------
define tokenize with source
    change tokens to empty list
    set i to 1
    repeat while i is at most length of source
        set ch to item i of source
        if ch is " "
            add 1 to i
        otherwise if "0123456789." contains ch
            set piece to ""
            repeat while i is at most length of source and "0123456789." contains item i of source
                add item i of source to piece
                add 1 to i
            add number of piece to tokens
        otherwise if "+-*/%^()" contains ch
            add ch to tokens
            add 1 to i
        otherwise
            fail with "I don't understand the character \"{ch}\"."

note: ---------- step 2: understand the tokens ----------
define peek
    if position is greater than how many items in tokens
        give back ""
    give back item position of tokens

define parse_expression
    set left to parse_term
    repeat while peek is "+" or peek is "-"
        set op to peek
        add 1 to position
        set right to parse_term
        if op is "+"
            set left to left + right
        otherwise
            set left to left - right
    give back left

define parse_term
    set left to parse_unary
    repeat while peek is "*" or peek is "/" or peek is "%"
        set op to peek
        add 1 to position
        set right to parse_unary
        if op is "*"
            set left to left * right
        otherwise if op is "/"
            set left to left / right
        otherwise
            set left to left % right
    give back left

note: a minus sign applies after ^, so -2^2 is -(2^2) = -4, while 2^-1 still works
define parse_unary
    if peek is "-"
        add 1 to position
        give back 0 - parse_unary
    if peek is "+"
        add 1 to position
        give back parse_unary
    give back parse_power

note: ^ groups to the right: 2^3^2 is 2^(3^2)
define parse_power
    set base to parse_primary
    if peek is "^"
        add 1 to position
        give back base to the power of (parse_unary)
    give back base

define parse_primary
    set seen to peek
    if seen is a number
        add 1 to position
        give back seen
    if seen is "("
        add 1 to position
        set value to parse_expression
        if peek is not ")"
            fail with "A bracket was opened but never closed."
        add 1 to position
        give back value
    if seen is ""
        fail with "The expression ended too early."
    fail with "I didn't expect \"{seen}\" here."

note: ---------- step 3: put it together ----------
define calculate with source
    change position to 1
    tokenize with source
    if how many items in tokens is 0
        fail with "please type something to calculate."
    set answer to parse_expression
    if position is at most how many items in tokens
        fail with "I didn't expect \"{item position of tokens}\" after the end of the calculation."
    give back answer

say "Calculator. Type an expression, or 'quit'."
repeat while yes
    ask "> " and save it as line
    if lowercase of line is "quit"
        stop
    try
        say calculate with line
    if that fails
        say "Error: {problem}"
