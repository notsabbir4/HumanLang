{
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:age} is at least ${2:18}",
      "    $0"
    ],
    "description": "if block"
  },
  "if/otherwise": {
    "prefix": "ifo",
    "body": [
      "if ${1:condition}",
      "    $2",
      "otherwise",
      "    $0"
    ],
    "description": "if with otherwise"
  },
  "repeat times": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3} times",
      "    $0"
    ]
  },
  "repeat while": {
    "prefix": "repeatw",
    "body": [
      "repeat while ${1:condition}",
      "    $0"
    ]
  },
  "for each": {
    "prefix": "foreach",
    "body": [
      "for each ${1:item} in ${2:items}",
      "    $0"
    ]
  },
  "define": {
    "prefix": "define",
    "body": [
      "define ${1:name} with ${2:a} and ${3:b}",
      "    give back ${0:a + b}"
    ]
  },
  "try": {
    "prefix": "try",
    "body": [
      "try",
      "    $1",
      "if that fails",
      "    say problem$0"
    ]
  },
  "ask": {
    "prefix": "ask",
    "body": [
      "ask ${1|number,|} \"${2:Question?}\" and save it as ${3:answer}"
    ]
  },
  "record": {
    "prefix": "record",
    "body": [
      "set ${1:person} to record with ${2:name} ${3:\"Ann\"} and ${4:age} ${5:30}"
    ],
    "description": "make a record"
  },
  "fail": {
    "prefix": "fail",
    "body": [
      "fail with \"${1:What went wrong}\""
    ],
    "description": "raise an error that try can catch"
  },
  "use file": {
    "prefix": "usefile",
    "body": [
      "use \"${1:helpers}.hum\""
    ],
    "description": "Bring in another HumanLang file"
  },
  "read csv": {
    "prefix": "csv",
    "body": [
      "use files",
      "set ${1:rows} to read csv \"${2:data}.csv\"",
      "for each ${3:row} in ${1:rows}",
      "    say field ${4:name} of ${3:row}"
    ],
    "description": "Read a CSV file as records"
  },
  "show a page": {
    "prefix": "page",
    "body": [
      "show a page titled \"${1:My page}\" with background ${2:white}",
      "    put a heading \"${3:Welcome}\"",
      "    $0"
    ],
    "description": "A page (design)"
  },
  "put a button": {
    "prefix": "button",
    "body": [
      "put a button \"${1:Click me}\" with background ${2:blue}, colour ${3:white}, rounded"
    ],
    "description": "A button on a page"
  },
  "put a text": {
    "prefix": "text",
    "body": [
      "put a text \"${1:Hello}\" with size ${2:big}"
    ],
    "description": "Words on a page"
  },
  "put a drawing": {
    "prefix": "drawing",
    "body": [
      "put a drawing with width ${1:300}, height ${2:200}, background ${3:sky blue}",
      "    put a circle at ${4:150}, ${5:100} with radius ${6:50} and colour ${7:yellow}",
      "    $0"
    ],
    "description": "A drawing (shapes at spots)"
  },
  "put pixel art": {
    "prefix": "pixelart",
    "body": [
      "put pixel art at ${1:10}, ${2:10} with pixel size ${3:12}",
      "    where \"${4:r}\" is ${5:red}",
      "    \"${4:r}${4:r}\"",
      "    \"${4:r}${4:r}\""
    ],
    "description": "Pixel art: each letter is a colour"
  }
}
