note: ==================================================
note: SAVING (remember and recall)
note: ==================================================

define load_save
    for each i from 1 to 7
        set v to recall "odyssey done {i}"
        if v is not nothing
            change item i of wdone to v
    set v to recall "odyssey coins"
    if v is not nothing
        change coins_total to v
    set v to recall "odyssey w5 best"
    if v is not nothing
        change w5_best to v
    set v to recall "odyssey w6 best"
    if v is not nothing
        change w6_best to v

define save_all
    for each i from 1 to 7
        remember (item i of wdone) as "odyssey done {i}"
    remember coins_total as "odyssey coins"
    remember w5_best as "odyssey w5 best"
    remember w6_best as "odyssey w6 best"

note: ==================================================
note: SMALL HELPERS
note: ==================================================

define say_msg with words
    change msg to words
    change msg_t to 150

define text_at with words and x and y and size and tint and place
    if place is "center"
        put a text words at x, y with size size and colour tint and bold and align center
    otherwise if place is "right"
        put a text words at x, y with size size and colour tint and bold and align right
    otherwise
        put a text words at x, y with size size and colour tint and bold and align left

define shadow_text with words and x and y and size and tint and place
    text_at with words and (x + 1) and (y + 1) and size and "#0B0E1C" and place
    text_at with words and x and y and size and tint and place

define clock_text with seconds
    set m to floor of (seconds / 60)
    set s to seconds - m * 60
    if s is less than 10
        give back "{m}:0{s}"
    give back "{m}:{s}"

define bands with colours
    for each i from 1 to 9
        set band_c to item i of colours
        put a rectangle at 0, (i - 1) * 30 with width 480 and height 31 and colour band_c

define wave with t
    give back calculate "sin({t})"

define scrolled with f
    give back (cam_x * f) mod 224

define tower_off with f
    give back (cam_x * f) mod 130

