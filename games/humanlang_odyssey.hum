set sky_w1 to list of "#4F9FE6", "#62AEEC", "#76BCF1", "#8BC8F5", "#A1D4F8", "#B7DFFA", "#CDE9FC", "#E1F3FD", "#F2FAFE"
set sky_w5 to list of "#1B1750", "#2B2275", "#44308F", "#6A3FA0", "#9B4FA6", "#C9609F", "#EF7F8D", "#FBA37A", "#FEC98A"

