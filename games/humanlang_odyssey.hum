set world_tips to list of "Talk to Echo and open the code gates.", "Build machines that sort and count.", "Puzzles with words and numbers.", "Paint your own pixel art.", "Run, jump and stomp the glitch bugs!", "A long boss fight. Dodge everything.", "Build, save and play your own level."

note: the code gates (the outputs below were made by really running the code in HumanLang)
set pz_goal to list of "Which line makes the gate say:  Hello, Mia!", "Which number makes the gate count:  1 2 3"
set pz_code_a to list of "set name to \"Mia\"", "for each n from 1 to ___"
set pz_code_b to list of "___", "    say n"
set pz_opts to empty list
add (list of "say \"Hello, name!\"", "say \"Hello, \{name\}!\"", "say \"Hello, Mia\"") to pz_opts
add (list of "2", "3", "4") to pz_opts
set pz_outs to empty list
add (list of "Hello, name!", "Hello, Mia!", "Hello, Mia") to pz_outs
add (list of "1 2", "1 2 3", "1 2 3 4") to pz_outs
set pz_answer to list of 2, 2

note: what Echo says (two lines on each page)
set echo_a to list of "Hello! I am Echo, your guide.", "Code is just words a computer can read.", "Two gates block the way. Each one is a puzzle."
set echo_b to list of "Welcome to the Motherboard!", "HumanLang writes it almost like English.", "Read the code, pick the right piece, open the gate."
set echo2_a to list of "Nice! The first gate is open.", "One more gate, then the exit portal."
set echo2_b to list of "Loops repeat things for you.", "Count to three and walk through."
set scroll_text to list of "Scroll: say shows words on the screen.", "Scroll: set puts a value in a box with a name.", "Scroll: for each repeats a line again and again."
set door_x to list of 150, 380, 610, 840, 1070, 1300, 1530

note: ==================================================
note: SAVING (remember and recall)
note: ==================================================

define load_save
    set v to recall "odyssey w1"
    if v is not nothing
        change w1_done to v
    set v to recall "odyssey w5"
    if v is not nothing
        change w5_done to v
    set v to recall "odyssey coins"
    if v is not nothing
        change coins_total to v
    set v to recall "odyssey w5 best"
    if v is not nothing
        change w5_best to v

define save_all
    remember w1_done as "odyssey w1"
    remember w5_done as "odyssey w5"
    remember coins_total as "odyssey coins"
    remember w5_best as "odyssey w5 best"

note: ==================================================
note: SMALL HELPERS
note: ==================================================

define say_msg with words
    change msg to words
    change msg_t to 150

define text_at with words and x and y and size and tint and place
    if place is "center"
        put a text words at x, y with size size and colour tint and bold and align center
    otherwise if place is "right"
        put a text words at x, y with size size and colour tint and bold and align right
    otherwise
        put a text words at x, y with size size and colour tint and bold and align left

define shadow_text with words and x and y and size and tint and place
    text_at with words and (x + 1) and (y + 1) and size and "#0B0E1C" and place
    text_at with words and x and y and size and tint and place

define clock_text with seconds
    set m to floor of (seconds / 60)
    set s to seconds - m * 60
    if s is less than 10
        give back "{m}:0{s}"
    give back "{m}:{s}"

define bands with colours
    for each i from 1 to 9
        set band_c to item i of colours
        put a rectangle at 0, (i - 1) * 30 with width 480 and height 31 and colour band_c

define wave with t
    give back calculate "sin({t})"

define scrolled with f
    give back (cam_x * f) mod 224

note: ==================================================
note: STARTING PLACES
note: ==================================================

define place_hero with x and y
    move the body hero to x, y
    make the body hero stop
    change spawn_x to x
    change spawn_y to y
    change hurt_t to 0
    change cam_x to x - 240
    if cam_x is less than 0
        change cam_x to 0

define start_hub with x
    change mode to "hub"
    change world_w to 1760
    change talk_on to no
    change pz to 0
    place_hero with x and 184
    play the music "chill"

