note: ==================================================
note: THE HERO
note: ==================================================

define hero_free
    note: can the hero move right now? (not while talking, solving a gate or seeing a result)
    give back (not talk_on) and pz is 0 and done_t is 0 and not (mode is "w7" and edit_on)

define hero_move
    set on_ground to the body hero is on the ground
    if hero_free
        if key "left" is down
            make the body hero run left
            change face_left to yes
        otherwise if key "right" is down
            make the body hero run right
            change face_left to no
        otherwise
            make the body hero stop
        if key "space" is down or key "up" is down
            if on_ground
                make the body hero jump
                play the sound "jump"
    otherwise
        make the body hero stop
    if mode is "hub"
        update the body hero on the map hubmap with solid "H" and "J" and "h" and "k"
    otherwise if mode is "gw"
        if wn is 1
            update the body hero on the map w1map with solid "G" and "D" and "E"
        otherwise if wn is 2
            update the body hero on the map w2map with solid "M" and "m"
        otherwise
            update the body hero on the map w3map with solid "G" and "D" and "E"
    otherwise if mode is "w5"
        update the body hero on the map w5map with solid "N" and "S"
    otherwise if mode is "w6"
        update the body hero on the map w6map with solid "C" and "S"
    otherwise
        update the body hero on the map usermap with solid "G" and "D" and "S"
    set hx to the x of the body hero
    if hx is less than 0
        move the body hero to 0, (the y of the body hero)
    if hx is greater than world_w - 22
        move the body hero to world_w - 22, (the y of the body hero)

define hero_pose
    note: frames: 1 stand, 2-6 run, 7 jump up, 8 top of the jump, 9 fall, 10 hurt, 11 cheer
    if hurt_t is greater than 55
        give back 10
    if done_t is greater than 0
        give back 11
    if not (the body hero is on the ground)
        set vy to the vertical speed of the body hero
        if vy is less than -1.5
            give back 7
        if vy is greater than 1.5
            give back 9
        give back 8
    set vx to the horizontal speed of the body hero
    if vx is greater than 0.3 or vx is less than -0.3
        give back 2 + (floor of (tick / 5)) mod 5
    give back 1

define draw_hero
    set blink to hurt_t is greater than 0 and (floor of (tick / 3)) mod 2 is 0 and hurt_t is at most 55
    if not blink
        set hx to the x of the body hero
        set hy to the y of the body hero
        draw the sprite hero at hx - 21, hy - 12 frame hero_pose facing left when face_left

define follow_camera
    set target to (the x of the body hero) - 228
    if target is less than 0
        set target to 0
    if target is greater than world_w - 480
        set target to world_w - 480
    change cam_x to cam_x + (target - cam_x) * 0.14
    if shake_t is greater than 0
        subtract 1 from shake_t

define hurt_hero
    note: lose a heart, and a short moment where nothing can hurt you
    if hurt_t is 0
        subtract 1 from hp
        change hurt_t to 100
        change shake_t to 12
        play the sound "hit"
        if hp is at most 0
            respawn_hero

define respawn_hero
    note: out of hearts or fell into a pit: back to the last flag with full hearts
    change hp to 3
    move the body hero to spawn_x, spawn_y
    make the body hero stop
    change hurt_t to 100
    play the sound "lose"
    say_msg with "Try again! You are back at the last flag."

note: ==================================================
note: COINS, SCROLLS AND THINGS TO PICK UP
note: ==================================================

define pick_up_coins
    set hx to the x of the body hero
    set hy to the y of the body hero
    for each i from 1 to length of coin_x
        if item i of coin_got is 0
            set coin_cx to item i of coin_x
            set coin_cy to item i of coin_y
            if coin_cx + 14 is greater than hx and coin_cx is less than hx + 22 and coin_cy + 14 is greater than hy and coin_cy is less than hy + 40
                change item i of coin_got to 1
                add 1 to coins
                play the sound "coin"

define draw_coins
    set beat to 1 + (floor of (tick / 7)) mod 4
    for each i from 1 to length of coin_x
        if item i of coin_got is 0
            set coin_cx to item i of coin_x
            if coin_cx is greater than cam_x - 20 and coin_cx is less than cam_x + 490
                draw the sprite coin at coin_cx, item i of coin_y frame beat

define draw_scrolls
    set beat to 1 + (floor of (tick / 14)) mod 2
    for each i from 1 to 3
        if item i of scroll_got is 0
            set sx to item i of scroll_x
            set sy to (item i of scroll_y) + floor of (3 * (wave with (tick / 12 + i)))
            draw the sprite scroll at sx, sy frame beat

define pick_up_scrolls
    set hx to the x of the body hero
    set hy to the y of the body hero
    for each i from 1 to 3
        if item i of scroll_got is 0
            set sx to item i of scroll_x
            set sy to item i of scroll_y
            if sx + 18 is greater than hx and sx is less than hx + 22 and sy + 20 is greater than hy and sy is less than hy + 40
                change item i of scroll_got to 1
                add 1 to scroll_n
                play the sound "powerup"
                say_msg with (item ((wn - 1) * 3 + i) of scroll_text)

note: ==================================================
note: BACKGROUNDS
note: ==================================================

define backdrop with which and f
    note: the picture is wider than the screen and slides a little as the camera moves (the far scenery moves slowly)
    set off to floor of (cam_x * f)
    if which is 1
        draw the sprite bg_meadow at 0 - off, 0
    otherwise
        draw the sprite bg_snow at 0 - off, 0

define draw_decor
    for each i from 1 to length of decor_k
        set dx to item i of decor_x
        if dx is greater than cam_x - 80 and dx is less than cam_x + 500
            set k to item i of decor_k
            set dy to item i of decor_y
            if k is 1
                draw the sprite tree at dx - 22, dy - 76
            otherwise if k is 2
                draw the sprite bush at dx, dy - 20
            otherwise if k is 3
                draw the sprite flower_a at dx, dy - 16
            otherwise if k is 4
                draw the sprite flower_b at dx, dy - 16
            otherwise if k is 5
                draw the sprite tuft at dx, dy - 10
            otherwise if k is 6
                draw the sprite rock at dx, dy - 16
            otherwise if k is 7
                draw the sprite pine at dx - 10, dy - 72
            otherwise if k is 8
                draw the sprite sign at dx, dy - 34
            otherwise if k is 9
                draw the sprite gear at dx, dy - 30 frame 1 + (floor of (tick / 20)) mod 2
            otherwise if k is 10
                draw the sprite crate at dx, dy - 24
            otherwise if k is 11
                draw the sprite lamp at dx, dy - 58
            otherwise if k is 12
                draw the sprite house_a at dx - 20, dy - 70
            otherwise if k is 13
                draw the sprite house_b at dx - 20, dy - 70
            otherwise if k is 14
                draw the sprite terminal at dx, dy - 38
            otherwise if k is 15
                draw the sprite dish at dx, dy - 52 frame 1 + (floor of (tick / 30)) mod 2
            otherwise if k is 16
                draw the sprite fern at dx, dy - 24 frame 1 + (floor of ((tick + dx) / 40)) mod 2

define draw_w1_world
    move the camera to 0, 0
    put a rectangle at 0, 0 with width 480 and height 270 and colour "#2F7FE8"
    backdrop with 1 and 0.17
    move the camera to cam_x, 0
    if wn is 1
        draw the map w1map
    otherwise
        draw the map w3map
    draw_decor

define draw_w2_world
    move the camera to 0, 0
    bands with sky_w2
    for each i from 1 to 36
        set sx to (i * 97) mod 480
        set sy to (i * 53) mod 130
        if (floor of ((tick + i * 13) / 25)) mod 4 is not 0
            put a rectangle at sx, sy with width 2 and height 2 and colour "#FFB85E"
    for each k from 0 to 4
        draw the sprite tower at k * 130 - (tower_off with 0.3) + 10, 70 frame 1 + (floor of ((tick + k * 20) / 40)) mod 2
    move the camera to cam_x, 0
    draw the map w2map
    draw_decor

define draw_w5_world
    move the camera to 0, 0
    put a rectangle at 0, 0 with width 480 and height 270 and colour "#3A2A7A"
    backdrop with 2 and 0.07
    for each i from 1 to 24
        set sx to ((i * 83) mod 480)
        set sy to (i * 37) mod 110
        if (floor of ((tick + i * 9) / 20)) mod 3 is not 0
            put a rectangle at sx, sy with width 2 and height 2 and colour "#FFF1D6"
    move the camera to cam_x, 0
    draw the map w5map
    draw_decor

define draw_hub_world
    move the camera to 0, 0
    bands with sky_hub
    for each i from 1 to 44
        set sx to (i * 97) mod 480
        set sy to (i * 53) mod 150
        if (floor of ((tick + i * 13) / 25)) mod 4 is not 0
            put a rectangle at sx, sy with width 2 and height 2 and colour "#7FA8FF"
    set moon_x to 400 - floor of (cam_x * 0.03)
    put a circle at moon_x, 52 with radius 20 and colour "#9FB8F0"
    put a circle at moon_x - 1, 51 with radius 17 and colour "#D6E4FF"
    put a circle at moon_x + 6, 58 with radius 4 and colour "#B4C8F4"
    put a circle at moon_x - 7, 45 with radius 3 and colour "#B4C8F4"
    set lit to 1
    if (sum of wdone) is at least 3
        set lit to 2
    if (sum of wdone) is at least 6
        set lit to 3
    set far_off to floor of (cam_x * 0.1) mod 480
    draw the sprite city_far at 0 - far_off, 84
    draw the sprite city_far at 480 - far_off, 84
    set near_off to floor of (cam_x * 0.28) mod 480
    draw the sprite city_near at 0 - near_off, 112 frame lit
    draw the sprite city_near at 480 - near_off, 112 frame lit
    move the camera to cam_x, 0
    draw the sprite chip at 827, 74 frame 1 + (floor of (tick / 40)) mod 2
    draw the map hubmap
    draw_decor
    draw the sprite echo at 104, 170 frame 1 + (floor of (tick / 40)) mod 2 facing left
    for each i from 1 to 7
        set dx to item i of door_x
        draw_hub_door with i and dx
    move the camera to 0, 0
    for each i from 1 to 16
        set spx to (i * 131) mod 480
        set spy to 224 - ((tick * (0.3 + (i mod 3) * 0.2) + i * 41) mod 200)
        put a rectangle at spx, spy with width 2 and height 2 and colour "#7FE8FF"
    move the camera to cam_x, 0

define draw_hub_door with i and dx
    set st to 1 + (floor of (tick / 30)) mod 2
    if item i of wdone is 1
        set st to 3
    draw the sprite portal_door at dx, 152 frame (i - 1) * 3 + st
    set label_x to floor of (dx + 25 - cam_x)
    shadow_text with "{i}" and label_x and 132 and 16 and "#FFFFFF" and "center"
    if item i of wdone is 1
        draw the sprite star at dx + 20, 116

note: ==================================================
note: HUD AND MESSAGES
note: ==================================================

define draw_hud with title
    move the camera to 0, 0
    for each i from 1 to 3
        set f to 2
        if i is at most hp
            set f to 1
        draw the sprite heart at 10 + (i - 1) * 16, 8 frame f
    draw the sprite coin at 10, 26 frame 1
    shadow_text with "{coins}" and 28 and 25 and 12 and "#FFE680" and "left"
    shadow_text with title and 240 and 7 and 12 and "#FFFFFF" and "center"
    if msg_t is greater than 0
        subtract 1 from msg_t
        put a rectangle at 60, 232 with width 360 and height 26 and colour "#0B0E1C" and border 2 and border colour "#FFE680" and rounded 6
        text_at with msg and 240 and 238 and 11 and "#FFFFFF" and "center"

define draw_talk
    if talk_on
        put a rectangle at 16, 188 with width 448 and height 74 and colour "#0B1026" and border 2 and border colour "#7FD6FF" and rounded 8
        put a rectangle at 22, 194 with width 52 and height 62 and colour "#141C3E" and rounded 6
        draw the sprite echo at 28, 202 frame 1 + (floor of (tick / 24)) mod 2
        text_at with "ECHO" and 86 and 196 and 11 and "#7FD6FF" and "left"
        set la to item talk_i of talk_a
        set lb to item talk_i of talk_b
        set shown to talk_n
        put a text (first shown letters of la) at 86, 214 with size 12 and colour white
        if shown is greater than length of la
            put a text (first (shown - length of la) letters of lb) at 86, 234 with size 12 and colour white
        if shown is at least length of la + length of lb
            if (floor of (tick / 20)) mod 2 is 0
                put a text "Enter" at 452, 246 with size 10 and colour "#7FD6FF" and align right

define start_talk with lines_a and lines_b and after
    change talk_a to lines_a
    change talk_b to lines_b
    change talk_i to 1
    change talk_n to 0
    change talk_on to yes
    change talk_after to after
    make the body hero stop

define update_talk
    if talk_on
        set total to length of (item talk_i of talk_a) + length of (item talk_i of talk_b)
        if talk_n is less than total
            add 1 to talk_n
            if tick mod 2 is 0
                play the sound "step"
        if k_enter or k_space
            if talk_n is less than total
                change talk_n to total
            otherwise if talk_i is less than length of talk_a
                add 1 to talk_i
                change talk_n to 0
            otherwise
                change talk_on to no
                if talk_after is "gate2"
                    change gate2_seen to yes
                otherwise
                    change echo_seen to yes
            change k_enter to no
            change k_space to no

note: ==================================================
note: THE CODE GATES (puzzles)
note: ==================================================

define draw_panel
    if pz is greater than 0
        put a rectangle at 40, 30 with width 400 and height 214 and colour "#0B1026" and border 2 and border colour "#FFE680" and rounded 10
        set gate_n to ((pz - 1) mod 2) + 1
        text_at with "CODE GATE {gate_n}" and 240 and 38 and 15 and "#FFE680" and "center"
        text_at with (item pz of pz_goal) and 240 and 62 and 12 and "#FFFFFF" and "center"
        put a rectangle at 70, 84 with width 340 and height 62 and colour "#05070F" and border 1 and border colour "#3B4A7A" and rounded 6
        put a text (item pz of pz_code_a) at 84, 92 with size 13 and colour "#8FF2AE" and font monospace
        put a text (item pz of pz_code_b) at 84, 114 with size 13 and colour "#8FF2AE" and font monospace
        for each o from 1 to 3
            set bx to 52 + (o - 1) * 128
            set c to "#1B2548"
            if o is pz_sel
                set c to "#2D5CC8"
            set bc to "#3B4A7A"
            if o is pz_sel
                set bc to "#FFE680"
            put a rectangle at bx, 156 with width 118 and height 28 and colour c and border 2 and border colour bc and rounded 6
            text_at with (item o of (item pz of pz_opts)) and (bx + 59) and 164 and 11 and "#FFFFFF" and "center"
        if pz_stage is "pick"
            text_at with "Left and Right choose, Enter opens the gate" and 240 and 196 and 10 and "#9AA3C0" and "center"
        otherwise
            text_at with "HumanLang says:" and 240 and 192 and 10 and "#9AA3C0" and "center"
            set pz_col to "#FF8E8E"
            if pz_right
                set pz_col to "#8FF2AE"
            text_at with pz_out and 240 and 206 and 13 and pz_col and "center"
            if pz_right
                text_at with "The gate opens! (Enter)" and 240 and 226 and 11 and "#FFE680" and "center"
            otherwise
                text_at with "Not quite. Try another one (Enter)" and 240 and 226 and 11 and "#FFE680" and "center"

set pz_right to no

define update_panel
    if pz is greater than 0
        if pz_stage is "pick"
            if k_left and pz_sel is greater than 1
                subtract 1 from pz_sel
                play the sound "blip"
            if k_right and pz_sel is less than 3
                add 1 to pz_sel
                play the sound "blip"
            if k_enter or k_space
                change pz_stage to "show"
                change pz_out to item pz_sel of (item pz of pz_outs)
                change pz_right to pz_sel is (item pz of pz_answer)
                if pz_right
                    play the sound "win"
                otherwise
                    play the sound "lose"
        otherwise
            if k_enter or k_space
                if pz_right
                    if ((pz - 1) mod 2) is 0
                        change gate1_open to yes
                    otherwise
                        change gate2_open to yes
                    change pz to 0
                    say_msg with "The gate is open. Keep going!"
                otherwise
                    change pz_stage to "pick"
        change k_enter to no
        change k_space to no

note: ==================================================
note: THE SCREENS
note: ==================================================

define draw_title
    move the camera to 0, 0
    put a rectangle at 0, 0 with width 480 and height 270 and colour "#2F7FE8"
    set drift to floor of (60 + 50 * (wave with (tick / 300)))
    draw the sprite bg_meadow at 0 - drift, 0
    draw the sprite t_grass at 0, 224
    for each k from 0 to 29
        draw the sprite t_grass at k * 16, 224
        draw the sprite t_dirt at k * 16, 240
        draw the sprite t_deep at k * 16, 256
    draw the sprite logo at 124, 16
    shadow_text with "ODYSSEY" and 240 and 88 and 32 and "#FFE680" and "center"
    shadow_text with "SEVEN WORLDS" and 240 and 124 and 18 and "#FFFFFF" and "center"
    set bob to floor of (3 * (wave with (tick / 14)))
    draw the sprite title_hero at 24, 112
    draw the sprite echo at 380, 170 frame 1 + (floor of (tick / 30)) mod 2
    draw the sprite bush at 330, 204
    draw the sprite flower_a at 346, 208
    if (floor of (tick / 28)) mod 2 is 0
        shadow_text with "Press ENTER to start" and 262 and 190 and 15 and "#FFFFFF" and "center"
    if (sum of wdone) is greater than 0
        shadow_text with "Your progress was loaded." and 262 and 214 and 11 and "#8FF2AE" and "center"
    shadow_text with "The HumanLang adventure: seven worlds, one language." and 300 and 160 and 10 and "#FFFFFF" and "center"

define draw_done with title and line1 and line2
    move the camera to 0, 0
    put a rectangle at 0, 0 with width 480 and height 270 and colour "#0B1026"
    for each i from 1 to 24
        set sc to "#7FD6FF"
        if i mod 2 is 0
            set sc to "#FFE680"
        put a rectangle at (i * 83) mod 480, (i * 41 + tick) mod 270 with width 3 and height 3 and colour sc
    shadow_text with title and 240 and 26 and 26 and "#FFE680" and "center"
    draw the sprite hero at 208, 62 frame 11
    shadow_text with line1 and 240 and 128 and 15 and "#FFFFFF" and "center"
    shadow_text with line2 and 240 and 154 and 13 and "#8FF2AE" and "center"
    if (floor of (tick / 25)) mod 2 is 0
        shadow_text with "Press ENTER to go back to the Motherboard" and 240 and 214 and 12 and "#FFFFFF" and "center"

note: ==================================================
note: THE HUB
note: ==================================================

define update_hub
    hero_move
    follow_camera
    set hx to (the x of the body hero) + 11
    change near_door to 0
    for each i from 1 to 7
        if hx is greater than (item i of door_x) - 6 and hx is less than (item i of door_x) + 56
            change near_door to i
    if k_enter and near_door is greater than 0
        play the sound "powerup"
        if near_door is less than 4
            start_gw with near_door
        otherwise if near_door is 4
            start_w4
        otherwise if near_door is 5
            start_w5
        otherwise if near_door is 6
            start_w6
        otherwise
            start_w7
    draw_hub_world
    draw_hero
    move the camera to 0, 0
    if near_door is greater than 0
        set i to near_door
        put a rectangle at 90, 36 with width 300 and height 58 and colour "#0B1026" and border 2 and border colour "#FFE680" and rounded 8
        text_at with "WORLD {i}: {item i of world_names}" and 240 and 42 and 14 and "#FFE680" and "center"
        text_at with (item i of world_tips) and 240 and 62 and 11 and "#FFFFFF" and "center"
        text_at with "Enter: go in" and 240 and 77 and 10 and "#8FF2AE" and "center"
    draw_hud with "THE MOTHERBOARD"
    set done_count to sum of wdone
    text_at with "Worlds {done_count}/7   Coins {coins_total}" and 470 and 8 and 11 and "#9AA3C0" and "right"

note: ==================================================
note: WORLD 1: SAY HELLO
note: ==================================================

define gw_gate_block
    note: a closed gate is a wall: the hero cannot go through it
    set hx to the x of the body hero
    if not gate1_open and hx is greater than g1_x - 26
        move the body hero to g1_x - 26, (the y of the body hero)
    if not gate2_open and hx is greater than g2_x - 26
        move the body hero to g2_x - 26, (the y of the body hero)

define update_gw
    update_talk
    update_panel
    add 1 to world_t
    hero_move
    gw_gate_block
    follow_camera
    if hurt_t is greater than 0
        subtract 1 from hurt_t
    set hx to the x of the body hero
    note: Echo says hello the first time you walk up to him
    if not echo_seen and not talk_on and hx is greater than echo_x - 90
        start_talk with (item wn of echo_a_all) and (item wn of echo_b_all) and "echo"
    if not gate2_seen and not talk_on and gate1_open and hx is greater than g2_x - 150
        start_talk with (item wn of echo2_a_all) and (item wn of echo2_b_all) and "gate2"
    if hero_free
        pick_up_coins
        pick_up_scrolls
        update_bugs
        update_flags
        hazards
        if k_enter
            if not gate1_open and hx is greater than g1_x - 90 and hx is less than g1_x
                change pz to (wn - 1) * 2 + 1
                change pz_sel to 1
                change pz_stage to "pick"
            otherwise if gate1_open and not gate2_open and hx is greater than g2_x - 90 and hx is less than g2_x
                change pz to (wn - 1) * 2 + 2
                change pz_sel to 1
                change pz_stage to "pick"
            otherwise if hx is greater than echo_x - 50 and hx is less than echo_x + 60
                start_talk with (item wn of echo_a_all) and (item wn of echo_b_all) and "echo"
        if gate2_open and hx is greater than portal_x - 20 and hx is less than portal_x + 34
            finish_world with wn
    if wn is 2
        draw_w2_world
    otherwise
        draw_w1_world
    draw_scrolls
    draw_coins
    draw_flags
    draw the sprite echo at echo_x, 170 frame 1 + (floor of (tick / 40)) mod 2 facing left
    set g1f to 1
    if gate1_open
        set g1f to 2
    set g2f to 1
    if gate2_open
        set g2f to 2
    draw the sprite gate at g1_x, 154 frame g1f
    draw the sprite gate at g2_x, 154 frame g2f
    draw the sprite portal at portal_x, 160 frame 1 + (floor of (tick / 8)) mod 3
    draw_bugs
    draw_hero
    move the camera to 0, 0
    if not gate1_open and hx is greater than g1_x - 90 and hx is less than g1_x and pz is 0 and not talk_on
        shadow_text with "Enter: read the gate" and 240 and 170 and 12 and "#FFE680" and "center"
    if gate1_open and not gate2_open and hx is greater than g2_x - 90 and hx is less than g2_x and pz is 0 and not talk_on
        shadow_text with "Enter: read the gate" and 240 and 170 and 12 and "#FFE680" and "center"
    set title to "WORLD {wn}: {item wn of world_names}"
    draw_hud with title
    text_at with "Scrolls {scroll_n}/3" and 470 and 26 and 11 and "#FFE680" and "right"
    draw_talk
    draw_panel
    change k_enter to no

note: ==================================================
note: WORLD 5: PLATFORM PEAKS
note: ==================================================

define update_bugs
    set hx to the x of the body hero
    set hy to the y of the body hero
    set vy to the vertical speed of the body hero
    for each i from 1 to length of bug_x
        if item i of bug_alive is 1
            set b to item i of bug_x
            set d to item i of bug_dir
            set b to b + d * 0.7
            if b is less than item i of bug_lo
                set d to 1
            if b is greater than item i of bug_hi
                set d to -1
            change item i of bug_x to b
            change item i of bug_dir to d
            set by to item i of bug_y
            if hx + 22 is greater than b + 2 and hx is less than b + 28 and hy + 40 is greater than by and hy is less than by + 22
                if vy is greater than 0.5 and hy + 40 is less than by + 18
                    change item i of bug_alive to 0
                    make the body hero bounce
                    play the sound "explosion"
                    add 3 to coins
                otherwise
                    hurt_hero
                    if hurt_t is 100
                        move the body hero to hx + 0 - d * 14, hy - 6

define draw_bugs
    for each i from 1 to length of bug_x
        if item i of bug_alive is 1
            set b to item i of bug_x
            if b is greater than cam_x - 40 and b is less than cam_x + 500
                set by2 to item i of bug_y
                set bf to 1 + (floor of (tick / 10)) mod 2
                set going_left to (item i of bug_dir) is -1
                draw the sprite bug at b, by2 frame bf facing left when going_left

define update_flags
    set hx to the x of the body hero
    for each i from 1 to length of flag_x
        if item i of flag_on is 0 and hx is greater than (item i of flag_x) - 8
            change item i of flag_on to 1
            change spawn_x to item i of flag_x
            change spawn_y to (item i of flag_y) - 2
            play the sound "powerup"
            say_msg with "Checkpoint! If you fall, you come back here."

define draw_flags
    for each i from 1 to length of flag_x
        draw the sprite flag at (item i of flag_x), (item i of flag_y) frame (item i of flag_on) + 1

define tile_under with x and y
    if mode is "gw"
        if wn is 1
            give back tile at x, y of w1map
        otherwise if wn is 2
            give back tile at x, y of w2map
        otherwise
            give back tile at x, y of w3map
    otherwise if mode is "w5"
        give back tile at x, y of w5map
    otherwise if mode is "w7"
        give back tile at x, y of usermap
    give back ""

define hazards
    set hx to the x of the body hero
    set hy to the y of the body hero
    set under to tile_under with (hx + 11) and (hy + 41)
    if under is "^" or hy is greater than 262
        if hy is greater than 262
            respawn_hero
        otherwise
            hurt_hero
            if hurt_t is 100
                move the body hero to hx, hy - 30
                make the body hero bounce

define update_w5
    add 1 to world_t
    hero_move
    follow_camera
    if hurt_t is greater than 0
        subtract 1 from hurt_t
    if done_t is 0
        pick_up_coins
        update_bugs
        update_flags
        hazards
        set hx to the x of the body hero
        if hx is greater than 1984 - 6
            finish_w5
    draw_w5_world
    draw_coins
    draw_flags
    draw the sprite goal at 1984 - 6, 224 - 80 frame 1 + (floor of (tick / 12)) mod 2
    draw_bugs
    draw_hero
    move the camera to 0, 0
    for each i from 1 to 26
        set fx to ((i * 61) + tick * 0.4 * (1 + i mod 3 * 0.4)) mod 480
        set fy to ((i * 47) + tick * 0.9 * (1 + i mod 2 * 0.5)) mod 270
        put a rectangle at fx, fy with width 2 and height 2 and colour "#FFFFFF"
    draw_hud with "WORLD 5: PLATFORM PEAKS"
    set secs to floor of (world_t / 60)
    set clock to clock_text with secs
    text_at with "TIME {clock}" and 470 and 8 and 11 and "#FFFFFF" and "right"
    if w5_best is greater than 0
        set best_clock to clock_text with w5_best
        text_at with "BEST {best_clock}" and 470 and 26 and 11 and "#FFE680" and "right"
    change k_enter to no

define finish_world with n
    change done_world to n
    change mode to "wdone"
    change done_t to 1
    change item n of wdone to 1
    change coins_total to coins_total + coins
    save_all
    play the sound "win"

define finish_w5
    set secs to floor of (world_t / 60)
    change last_time to secs
    if w5_best is 0 or secs is less than w5_best
        change w5_best to secs
    finish_world with 5

define draw_wdone
    set n to done_world
    set total_coins to length of coin_x
    set l1 to "Coins {coins}"
    if n is less than 4
        set l1 to "Coins {coins}/{total_coins}     Scrolls {scroll_n}/3"
    if n is 4
        set l1 to "Every pixel is right!"
    if n is 5
        set clock to clock_text with last_time
        set l1 to "Coins {coins}/{total_coins}     Time {clock}"
    if n is 6
        set clock to clock_text with last_time
        set l1 to "The Glitch King is beaten in {clock}"
    if n is 7
        set l1 to "You made a level and you beat it!"
    draw_done with "WORLD {n} COMPLETE" and l1 and (item n of done_lines)
    if k_enter
        if (sum of wdone) is 7 and not ending_seen
            change mode to "ending"
            change ending_seen to yes
        otherwise
            start_hub with ((item n of door_x) + 6)


note: ==================================================
note: WORLD 4: PIXEL GALLERY (paint the picture)
note: ==================================================

define start_w4
    change mode to "w4"
    change world_w to 480
    change coins to 0
    change world_t to 0
    change done_t to 0
    change hp to 3
    change cam_x to 0
    change canvas to empty list
    for each i from 1 to 144
        add 0 to canvas
    change cx to 0
    change cy to 0
    change pcol to 1
    change coin_x to empty list
    change coin_y to empty list
    change coin_got to empty list
    play the music "chill"

define count_match
    set same to 0
    for each i from 1 to 144
        if (item i of canvas) is (item i of paint_target)
            add 1 to same
    give back same

define cell_colour with v
    if v is 0
        give back "#141C3E"
    give back item v of paint_pal

define update_w4
    add 1 to world_t
    if k_left and cx is greater than 0
        subtract 1 from cx
    if k_right and cx is less than 11
        add 1 to cx
    if k_up and cy is greater than 0
        subtract 1 from cy
    if k_down and cy is less than 11
        add 1 to cy
    if key "1" is down
        change pcol to 1
    if key "2" is down
        change pcol to 2
    if key "3" is down
        change pcol to 3
    if key "4" is down
        change pcol to 4
    set at to cy * 12 + cx + 1
    if key "space" is down
        change item at of canvas to pcol
    if key "x" is down
        change item at of canvas to 0
    set same to count_match
    if same is 144 and done_t is 0
        finish_world with 4
    move the camera to 0, 0
    bands with sky_hub
    draw the sprite easel at 30, 214
    draw the sprite easel at 420, 214
    put a rectangle at 14, 34 with width 170 and height 170 and colour "#0B1026" and border 2 and border colour "#FFE680" and rounded 6
    for each i from 1 to 144
        set r to floor of ((i - 1) / 12)
        set c to (i - 1) mod 12
        set colr to cell_colour with (item i of canvas)
        put a rectangle at 20 + c * 13, 40 + r * 13 with width 12 and height 12 and colour colr
    set cur to cell_colour with (item at of canvas)
    put a rectangle at 20 + cx * 13 - 1, 40 + cy * 13 - 1 with width 14 and height 14 and colour cur and border 2 and border colour "#FFFFFF"
    text_at with "YOUR PICTURE" and 99 and 210 and 10 and "#9AA3C0" and "center"
    put a rectangle at 232, 34 with width 110 and height 110 and colour "#0B1026" and border 2 and border colour "#7FD6FF" and rounded 6
    for each i from 1 to 144
        set r to floor of ((i - 1) / 12)
        set c to (i - 1) mod 12
        set colr to cell_colour with (item i of paint_target)
        put a rectangle at 238 + c * 8, 40 + r * 8 with width 8 and height 8 and colour colr
    text_at with "COPY THIS" and 287 and 148 and 10 and "#9AA3C0" and "center"
    for each o from 1 to 4
        set pc to item o of paint_pal
        set bc to "#3B4A7A"
        if o is pcol
            set bc to "#FFFFFF"
        put a rectangle at 360 + (o - 1) * 28, 40 with width 24 and height 24 and colour pc and border 2 and border colour bc and rounded 4
        text_at with "{o}" and (372 + (o - 1) * 28) and 68 and 11 and "#FFFFFF" and "center"
    text_at with "Arrows move" and 360 and 96 and 11 and "#FFFFFF" and "left"
    text_at with "Space paints" and 360 and 112 and 11 and "#FFFFFF" and "left"
    text_at with "1 2 3 4 pick a colour" and 360 and 128 and 11 and "#FFFFFF" and "left"
    text_at with "X rubs out" and 360 and 144 and 11 and "#FFFFFF" and "left"
    text_at with "Matching squares: {same}/144" and 360 and 168 and 11 and "#8FF2AE" and "left"
    text_at with "In HumanLang a picture is" and 232 and 196 and 10 and "#9AA3C0" and "left"
    text_at with "just letters: put pixel art" and 232 and 210 and 10 and "#9AA3C0" and "left"
    draw_hud with "WORLD 4: PIXEL GALLERY"
    change k_enter to no

note: ==================================================
note: WORLD 6: THE BOSS CITADEL (the Glitch King)
note: ==================================================

define start_w6
    change mode to "w6"
    change world_w to 480
    change hp to 3
    change coins to 0
    change world_t to 0
    change done_t to 0
    change boss_hp to boss_max
    change boss_x to 300
    change boss_dir to -1
    change boss_stun to 0
    change bolt_t to 0
    change bolt_x to empty list
    change bolt_y to empty list
    change bolt_w to empty list
    change bolt_on to empty list
    change coin_x to empty list
    change coin_y to empty list
    change coin_got to empty list
    change decor_k to empty list
    change decor_x to empty list
    change decor_y to empty list
    change bug_x to empty list
    change bug_y to empty list
    change bug_lo to empty list
    change bug_hi to empty list
    change bug_dir to empty list
    change bug_alive to empty list
    change flag_x to empty list
    change flag_y to empty list
    change flag_on to empty list
    place_hero with 40 and 184
    play the music "boss"

define boss_phase
    give back 1 + floor of ((boss_max - boss_hp) / 4)

define add_bolt with x
    set slot to 0
    for each i from 1 to length of bolt_x
        if slot is 0 and (item i of bolt_on) is 0
            set slot to i
    if slot is 0
        add x to bolt_x
        add -30 to bolt_y
        add 50 to bolt_w
        add 1 to bolt_on
    otherwise
        change item slot of bolt_x to x
        change item slot of bolt_y to -30
        change item slot of bolt_w to 50
        change item slot of bolt_on to 1

define update_boss
    set phase to boss_phase
    set boss_y to 152
    if boss_stun is greater than 0
        subtract 1 from boss_stun
    otherwise
        change boss_x to boss_x + boss_dir * (0.8 + 0.5 * phase)
        if boss_x is less than 20
            change boss_x to 20
            change boss_dir to 1
        if boss_x is greater than 396
            change boss_x to 396
            change boss_dir to -1
    set hx to the x of the body hero
    set hy to the y of the body hero
    set vy to the vertical speed of the body hero
    if hx + 22 is greater than boss_x + 6 and hx is less than boss_x + 58 and hy + 40 is greater than 146 and hy is less than 224
        if boss_stun is 0
            if vy is greater than 0.3 and hy + 40 is less than 182
                subtract 1 from boss_hp
                change boss_stun to 80
                make the body hero bounce
                play the sound "explosion"
                add 5 to coins
                say_msg with "Hit! {boss_hp} to go."
                if boss_hp is at most 0
                    finish_boss
            otherwise
                hurt_hero
                if hurt_t is 100
                    set side to 30
                    if hx is less than boss_x + 32
                        set side to -30
                    set nx to hx + side
                    if nx is less than 20
                        set nx to 20
                    if nx is greater than 438
                        set nx to 438
                    move the body hero to nx, hy - 8
    add 1 to bolt_t
    if bolt_t is greater than 200 - 35 * phase
        change bolt_t to 0
        add_bolt with (hx + 5)

define update_bolts
    set hx to the x of the body hero
    set hy to the y of the body hero
    for each i from 1 to length of bolt_x
        if (item i of bolt_on) is 1
            if (item i of bolt_w) is greater than 0
                change item i of bolt_w to (item i of bolt_w) - 1
            otherwise
                change item i of bolt_y to (item i of bolt_y) + 5
                set bx to item i of bolt_x
                set by to item i of bolt_y
                if hx + 22 is greater than bx and hx is less than bx + 12 and hy + 40 is greater than by and hy is less than by + 22
                    change item i of bolt_on to 0
                    hurt_hero
                if by is greater than 222
                    change item i of bolt_on to 0

define draw_boss
    set bf to 1 + (floor of (tick / 12)) mod 2
    if boss_stun is 0 or (floor of (tick / 3)) mod 2 is 0
        draw the sprite boss at boss_x, 152 frame bf

define draw_bolts
    for each i from 1 to length of bolt_x
        if (item i of bolt_on) is 1
            set bx to item i of bolt_x
            if (item i of bolt_w) is greater than 0
                if (floor of (tick / 4)) mod 2 is 0
                    draw the sprite warn at bx, 204
            otherwise
                draw the sprite bolt at bx, item i of bolt_y frame 1 + (floor of (tick / 4)) mod 2

define finish_boss
    set secs to floor of (world_t / 60)
    change last_time to secs
    if w6_best is 0 or secs is less than w6_best
        change w6_best to secs
    finish_world with 6

define draw_w6_world
    move the camera to 0, 0
    bands with sky_boss
    for each k from 0 to 4
        draw the sprite tower at k * 110 + 10, 100 frame 1 + (floor of ((tick + k * 20) / 40)) mod 2
    move the camera to 0, 0
    draw the map w6map

define update_w6
    add 1 to world_t
    hero_move
    follow_camera
    if hurt_t is greater than 0
        subtract 1 from hurt_t
    if done_t is 0
        update_boss
        update_bolts
        if (the y of the body hero) is greater than 262
            respawn_hero
    draw_w6_world
    draw_boss
    draw_bolts
    draw_hero
    move the camera to 0, 0
    put a rectangle at 150, 24 with width 180 and height 12 and colour "#2A0716" and border 2 and border colour "#FFFFFF" and rounded 4
    if boss_hp is greater than 0
        put a rectangle at 152, 26 with width boss_hp * 14 and height 8 and colour "#E43A4C" and rounded 3
    text_at with "THE GLITCH KING" and 240 and 38 and 10 and "#FFFFFF" and "center"
    draw_hud with "WORLD 6: THE BOSS CITADEL"
    change k_enter to no

note: ==================================================
note: WORLD 7: YOUR WORLD (build, save and play your own level)
note: ==================================================

define serialize_level
    set s to ""
    for each r from 1 to 14
        for each c from 1 to 30
            set t to tile in column c, row r of usermap
            if t is ""
                set t to "."
            set s to "{s}{t}"
    give back s

define apply_level with s
    for each r from 1 to 14
        for each c from 1 to 30
            set ch to item ((r - 1) * 30 + c) of s
            change tile in column c, row r of usermap to ch

define start_w7
    change mode to "w7"
    change world_w to 480
    change edit_on to yes
    change hp to 3
    change coins to 0
    change world_t to 0
    change done_t to 0
    change cam_x to 0
    change ux to 1
    change uy to 11
    change coin_x to empty list
    change coin_y to empty list
    change coin_got to empty list
    change decor_k to empty list
    change decor_x to empty list
    change decor_y to empty list
    change bug_x to empty list
    change bug_y to empty list
    change bug_lo to empty list
    change bug_hi to empty list
    change bug_dir to empty list
    change bug_alive to empty list
    change flag_x to empty list
    change flag_y to empty list
    change flag_on to empty list
    if not user_loaded
        change user_loaded to yes
        set v to recall "odyssey level"
        if v is not nothing
            if length of v is 420
                apply_level with v
    play the music "adventure"

define enter_play
    change level_backup to serialize_level
    change edit_on to no
    change coins to 0
    change hp to 3
    change hurt_t to 0
    place_hero with 20 and 60
    say_msg with "Reach the star! Press E to go back and edit."

define leave_play
    apply_level with level_backup
    change edit_on to yes
    change msg_t to 0

define update_w7
    add 1 to world_t
    if edit_on
        if k_left and ux is greater than 0
            subtract 1 from ux
        if k_right and ux is less than 29
            add 1 to ux
        if k_up and uy is greater than 0
            subtract 1 from uy
        if k_down and uy is less than 13
            add 1 to uy
        if key "1" is down
            change utile to 1
        if key "2" is down
            change utile to 2
        if key "3" is down
            change utile to 3
        if key "4" is down
            change utile to 4
        if key "5" is down
            change utile to 5
        if key "6" is down
            change utile to 6
        if key "space" is down
            change tile in column ux + 1, row uy + 1 of usermap to (item utile of user_letters)
        if key "x" is down
            change tile in column ux + 1, row uy + 1 of usermap to "."
        if k_s
            remember serialize_level as "odyssey level"
            say_msg with "Level saved!"
            play the sound "powerup"
        if k_l
            set v to recall "odyssey level"
            if v is not nothing
                apply_level with v
                say_msg with "Level loaded!"
        if k_enter
            enter_play
    otherwise
        hero_move
        follow_camera
        if hurt_t is greater than 0
            subtract 1 from hurt_t
        if done_t is 0
            set hx to (the x of the body hero) + 11
            set hy to (the y of the body hero) + 30
            set here to tile at hx, hy of usermap
            if here is "c"
                change tile at hx, hy of usermap to "."
                add 1 to coins
                play the sound "coin"
            hazards
            if here is "F"
                leave_play_for_finish
        if k_e
            leave_play
    move the camera to 0, 0
    put a rectangle at 0, 0 with width 480 and height 270 and colour "#2F7FE8"
    bands with sky_w1
    draw the map usermap
    if not edit_on
        draw_hero
    move the camera to 0, 0
    if edit_on
        set cur_x to ux * 16
        set cur_y to uy * 16
        put a rectangle at cur_x, cur_y with width 16 and height 2 and colour "#FFE680"
        put a rectangle at cur_x, cur_y + 14 with width 16 and height 2 and colour "#FFE680"
        put a rectangle at cur_x, cur_y with width 2 and height 16 and colour "#FFE680"
        put a rectangle at cur_x + 14, cur_y with width 2 and height 16 and colour "#FFE680"
    put a rectangle at 0, 226 with width 480 and height 44 and colour "#0B1026"
    if edit_on
        for each o from 1 to 6
            set bc to "#3B4A7A"
            if o is utile
                set bc to "#FFE680"
            put a rectangle at 8 + (o - 1) * 30, 232 with width 26 and height 26 and colour "#141C3E" and border 2 and border colour bc and rounded 4
            draw_tool with o and (14 + (o - 1) * 30) and 238
            text_at with "{o}" and (21 + (o - 1) * 30) and 259 and 9 and "#9AA3C0" and "center"
        text_at with "Arrows move   Space puts   X rubs out" and 196 and 234 and 10 and "#FFFFFF" and "left"
        text_at with "S saves   L loads   Enter plays your level" and 196 and 250 and 10 and "#8FF2AE" and "left"
    otherwise
        text_at with "Reach the star.   E: back to editing" and 240 and 240 and 12 and "#FFFFFF" and "center"
    draw_hud with "WORLD 7: YOUR WORLD"
    change k_enter to no

define draw_tool with o and x and y
    if o is 1
        draw the sprite t_grass at x - 4, y - 4
    otherwise if o is 2
        draw the sprite t_dirt at x - 4, y - 4
    otherwise if o is 3
        draw the sprite t_stone at x - 4, y - 4
    otherwise if o is 4
        draw the sprite t_spike at x - 4, y - 4
    otherwise if o is 5
        draw the sprite coin at x - 2, y - 2
    otherwise
        draw the sprite star at x - 1, y - 1

define leave_play_for_finish
    apply_level with level_backup
    finish_world with 7

note: ==================================================
note: THE END
note: ==================================================

define draw_ending
    move the camera to 0, 0
    put a rectangle at 0, 0 with width 480 and height 270 and colour "#0B1026"
    for each i from 1 to 30
        put a rectangle at (i * 83) mod 480, (i * 41 + tick) mod 270 with width 3 and height 3 and colour "#FFE680"
    shadow_text with "YOU DID IT!" and 240 and 20 and 30 and "#FFE680" and "center"
    draw the sprite hero at 208, 62 frame 11
    shadow_text with "All seven worlds are finished." and 240 and 128 and 15 and "#FFFFFF" and "center"
    shadow_text with "You can read and write HumanLang now." and 240 and 150 and 13 and "#8FF2AE" and "center"
    shadow_text with "Coins collected: {coins_total}" and 240 and 172 and 12 and "#FFE680" and "center"
    shadow_text with "Made with HumanLang by the HL mascot and you." and 240 and 196 and 11 and "#7FD6FF" and "center"
    if (floor of (tick / 25)) mod 2 is 0
        shadow_text with "Press ENTER to go back to the Motherboard" and 240 and 234 and 12 and "#FFFFFF" and "center"
    if k_enter
        start_hub with 60

note: ==================================================
note: THE GAME
note: ==================================================

play a game titled "HumanLang Odyssey: Seven Worlds" with size 480 by 270 and background black

    when the game starts
        load_save

    when the key "enter" is pressed
        change k_enter to yes

    when the key "left" is pressed
        change k_left to yes

    when the key "right" is pressed
        change k_right to yes

    when the key "space" is pressed
        change k_space to yes

    when the key "up" is pressed
        change k_up to yes

    when the key "down" is pressed
        change k_down to yes

    when the key "e" is pressed
        change k_e to yes

    when the key "s" is pressed
        change k_s to yes

    when the key "l" is pressed
        change k_l to yes

    every frame
        add 1 to tick
        if mode is "intro"
            play video "humanlang_intro.mp4"
            change mode to "title"
            play the music "chill"
        otherwise if mode is "title"
            draw_title
            if k_enter or k_space
                start_hub with 60
                play the sound "powerup"
        otherwise if mode is "hub"
            update_hub
        otherwise if mode is "gw"
            update_gw
        otherwise if mode is "w4"
            update_w4
        otherwise if mode is "w5"
            update_w5
        otherwise if mode is "w6"
            update_w6
        otherwise if mode is "w7"
            update_w7
        otherwise if mode is "wdone"
            draw_wdone
        otherwise if mode is "ending"
            draw_ending
        change k_enter to no
        change k_left to no
        change k_right to no
        change k_space to no
        change k_up to no
        change k_down to no
        change k_e to no
        change k_s to no
        change k_l to no
